# Copy this file to .env for local development (quasar dev).
# Production values live in .env.prod (used by quasar build).
API_BACKEND=http://localhost:5500/

# Google sign-in: OAuth 2.0 'Web application' client ID (public, not a secret).
# Leave it empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Cloudflare Turnstile site key (public). Leave it empty to turn it off.
# Test key for local dev (always passes): 1x00000000000000000000AA
TURNSTILE_SITE_KEY=
